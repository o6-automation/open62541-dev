libdir=/usr/local/lib
sharedlibdir=${libdir}
includedir=/usr/local/include

Name: open62541
Description: open62541 is an open source C (C99) implementation of OPC UA
Version: 1.5.2-111-gd7d099db8-dirty
Requires.private: 
Cflags: -I${includedir} -DUA_ENABLE_AMALGAMATION
Libs: -L${libdir} -lopen62541 -lpthread 
Libs.private: -lm -lpthread -lrt
